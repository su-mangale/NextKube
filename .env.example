# Backend API URL (Kubernetes Cluster / Platform Controller API)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# Port for Next.js web server
PORT=3000

# Authentication & Session Security (Phase 1)
# 32+ character random secret used to sign session cookies
NEXTKUBE_AUTH_SECRET=nextkube-super-secure-jwt-auth-secret-32chars!

# Default Bootstrap Admin Credentials (active if no htpasswd / NEXTKUBE_USERS is set)
NEXTKUBE_ADMIN_USER=admin
NEXTKUBE_ADMIN_PASSWORD=admin123

# Advanced User Store: either specify a file path or comma-separated user records
# NEXTKUBE_HTPASSWD_PATH=/etc/nextkube/htpasswd
# NEXTKUBE_USERS=admin:$2b$12$...:admin,operator:$2b$12$...:operator,viewer:$2b$12$...:viewer
